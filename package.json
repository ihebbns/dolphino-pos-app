{
  "name": "servio-coffee-more",
  "version": "1.1.0",
  "description": "ServioOS — Système de caisse POS multi-client",
  "main": "core/main.js",
  "author": "Servio OS",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "start:dolphino": "set CLIENT_DIR=clients/dolphino&& electron .",
    "start:mio_food": "set CLIENT_DIR=clients/mio_food&& electron .",
    "build:win": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "pack": "electron-builder --dir",
    "new-client": "node tools/new-client/server.mjs"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^24.13.3",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "tn.servio.pos.coffee_more",
    "productName": "Coffee More POS",
    "copyright": "© 2025 Servio OS",
    "asar": true,
    "directories": {
      "output": "dist_clients/Coffee_More"
    },
    "files": [
      "core/main.js",
      "core/database.js",
      "core/preload.js",
      "core/hub.js",
      "core/waiter.html",
      "index.html",
      "node_modules/sql.js/dist/**"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/**"
    ],
    "extraResources": [
      {
        "from": "assets/servio-drawer.exe",
        "to": "servio-drawer.exe"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Coffee More POS",
      "runAfterFinish": true,
      "artifactName": "Coffee_More_Setup.exe"
    },
    "portable": {
      "artifactName": "Coffee_More_Portable.exe"
    }
  }
}